From: prplmesh OpenWrt package
Subject: [PATCH] controller: query AP metrics from every agent periodically

The controller only relied on agents sending AP Metrics Responses on
their own (Metric Reporting Policy). Some third-party agents (seen with
a TP-Link RE500X) only answer AP Metrics Queries, so the controller never
got the link metrics of their associated stations. Send an AP Metrics
Query for all BSSes of each agent at the link metrics interval.

--- a/controller/src/beerocks/master/tasks/link_metrics_task.cpp
+++ b/controller/src/beerocks/master/tasks/link_metrics_task.cpp
@@ -13,6 +13,7 @@
 
 #include <beerocks/tlvf/beerocks_message.h>
 #include <tlvf/ieee_1905_1/tlvLinkMetricQuery.h>
+#include <tlvf/wfa_map/tlvApMetricQuery.h>
 #include <tlvf/wfa_map/tlvUnassociatedStaLinkMetricsQuery.h>
 #include <tlvf/wfa_map/tlvUnassociatedStaLinkMetricsResponse.h>
 
@@ -74,6 +75,37 @@
             son_actions::send_cmdu_to_agent(agent->al_mac, cmdu_tx, database);
         }
 
+        // Ask every agent for its AP metrics too. Agents that report them
+        // periodically (per the Metric Reporting Policy) are unaffected, but
+        // some third-party agents only answer queries; without this the
+        // controller never gets the RCPI of their associated stations.
+        for (const auto &agent : database.get_all_connected_agents()) {
+            std::vector<sMacAddr> bssids;
+            for (const auto &radio : agent->radios) {
+                for (const auto &bss : radio.second->bsses) {
+                    if (bss.second && bss.second->bssid != beerocks::net::network_utils::ZERO_MAC) {
+                        bssids.push_back(bss.second->bssid);
+                    }
+                }
+            }
+            if (bssids.empty()) {
+                continue;
+            }
+            if (!cmdu_tx.create(0, ieee1905_1::eMessageType::AP_METRICS_QUERY_MESSAGE)) {
+                LOG(ERROR) << "Failed building AP_METRICS_QUERY_MESSAGE!";
+                break;
+            }
+            auto query = cmdu_tx.addClass<wfa_map::tlvApMetricQuery>();
+            if (!query || !query->alloc_bssid_list(bssids.size())) {
+                LOG(ERROR) << "Failed building tlvApMetricQuery";
+                break;
+            }
+            for (size_t i = 0; i < bssids.size(); i++) {
+                std::get<1>(query->bssid_list(i)) = bssids[i];
+            }
+            son_actions::send_cmdu_to_agent(agent->al_mac, cmdu_tx, database);
+        }
+
         last_query_request = std::chrono::steady_clock::now();
     }
     return;
