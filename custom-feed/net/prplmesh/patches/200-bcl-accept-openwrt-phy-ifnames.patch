From: prplmesh OpenWrt package
Subject: [PATCH] bcl: accept stock OpenWrt phy<N>-ap<M> interface names

Stock OpenWrt names hostapd BSS netdevs phy<radio>-ap<bss> unless
wireless.*.ifname overrides them. beerocks only knew wlan<N>[.-]<M> and
wl<N>, so every radio had to be renamed by hand. Parse the phy scheme in
get_ids_from_iface_string() (radio id = N, VAP id = M) and build sibling
VAP names in the same scheme. wlan/wl handling is unchanged.

--- a/common/beerocks/bcl/source/beerocks_utils.cpp
+++ b/common/beerocks/bcl/source/beerocks_utils.cpp
@@ -106,6 +106,32 @@
     return result;
 }
 
+// Stock OpenWrt names hostapd BSS netdevs "phy<radio>-ap<bss>" (e.g. phy1-ap0)
+// unless wireless.*.ifname overrides it. Recognise that scheme so prplMesh
+// works without renaming the interfaces to wlan<N>.
+static bool parse_openwrt_phy_ifname(const std::string &iface, int &radio, int &bss)
+{
+    static const std::string phy("phy"), ap("-ap");
+    if (iface.compare(0, phy.size(), phy) != 0) {
+        return false;
+    }
+    auto ap_pos = iface.find(ap, phy.size());
+    if (ap_pos == std::string::npos || ap_pos == phy.size() ||
+        ap_pos + ap.size() >= iface.size()) {
+        return false;
+    }
+    auto radio_str = iface.substr(phy.size(), ap_pos - phy.size());
+    auto bss_str   = iface.substr(ap_pos + ap.size());
+    if (radio_str.find_first_not_of("0123456789") != std::string::npos ||
+        bss_str.find_first_not_of("0123456789") != std::string::npos ||
+        radio_str.size() > 3 || bss_str.size() > 3) {
+        return false;
+    }
+    radio = std::stoi(radio_str);
+    bss   = std::stoi(bss_str);
+    return true;
+}
+
 utils::sIfaceVapIds utils::get_ids_from_iface_string(const std::string &iface)
 {
     utils::sIfaceVapIds ids;
@@ -114,6 +140,20 @@
         return ids;
     }
 
+    int phy_radio, phy_bss;
+    if (parse_openwrt_phy_ifname(iface, phy_radio, phy_bss)) {
+        ids.iface_prefix = "phy";
+        ids.iface_sep    = '-';
+        ids.iface_id     = phy_radio;
+        if (phy_bss < beerocks::IFACE_VAP_ID_MIN || phy_bss > beerocks::IFACE_VAP_ID_MAX) {
+            LOG(DEBUG) << "Invalid VAP id " << phy_bss << " for interface " << iface;
+            ids.vap_id = beerocks::IFACE_ID_INVALID;
+            return ids;
+        }
+        ids.vap_id = phy_bss;
+        return ids;
+    }
+
     auto prefix_str = get_prefix_from_iface_string(iface);
     if (!is_allowed_ifname_prefix(prefix_str)) {
         LOG(ERROR) << "iface does not contain any allowed prefix, function input string: " << iface;
@@ -176,6 +216,10 @@
         LOG(ERROR) << "function input is not valid! iface=" << iface << ", vap_id=" << int(vap_id);
     } else if (vap_id == iface_ids.vap_id) {
         ifname = iface;
+    } else if (iface_ids.iface_prefix == "phy") {
+        // phy<N>-ap<M>; the radio itself is addressed through its first BSS
+        ifname = "phy" + std::to_string(iface_ids.iface_id) + "-ap" +
+                 std::to_string(vap_id >= beerocks::IFACE_VAP_ID_MIN ? vap_id : 0);
     } else {
         ifname = iface_ids.iface_prefix + std::to_string(iface_ids.iface_id);
         if (vap_id >= beerocks::IFACE_VAP_ID_MIN) {
