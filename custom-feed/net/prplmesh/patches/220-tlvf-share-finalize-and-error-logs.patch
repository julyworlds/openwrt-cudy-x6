From: prplmesh OpenWrt package
Subject: [PATCH] tlvf: share finalize() and buffer increment error logging

The generator emitted the same finalize() body and a separate
"buffPtrIncrementSafe(...) Failed!" log statement for every class and
field (670 and 2100 copies). Move both into BaseClass
(finalize_begin(), buffPtrIncrementSafeOrLog()) and let the generated
code call them. Behaviour and log messages are unchanged.

--- a/framework/tlvf/src/include/tlvf/BaseClass.h
+++ b/framework/tlvf/src/include/tlvf/BaseClass.h
@@ -27,6 +27,9 @@
     uint8_t *getStartBuffPtr();
     size_t getBuffRemainingBytes(void *start = nullptr);
     bool buffPtrIncrementSafe(size_t length);
+    // Same as buffPtrIncrementSafe(), but logs the failure. Used by the
+    // generated code so the error message exists once instead of per field.
+    bool buffPtrIncrementSafeOrLog(size_t length);
 
     size_t getLen();
     bool isInitialized();
@@ -56,6 +59,14 @@
     }
 
 protected:
+    /**
+     * Common part of the generated finalize() methods.
+     * @return -1 on failure, 0 if there is nothing left to do (parsing or
+     * already finalized), 1 if the caller must adjust its length by
+     * @a tailroom, swap and mark itself finalized.
+     */
+    int finalize_begin(size_t &tailroom);
+
     uint8_t *m_buff__;
     uint8_t *m_buff_ptr__;
     const size_t m_buff_len__;
--- a/framework/tlvf/src/src/BaseClass.cpp
+++ b/framework/tlvf/src/src/BaseClass.cpp
@@ -42,3 +42,38 @@
     m_buff_ptr__ += length;
     return true;
 }
+
+bool BaseClass::buffPtrIncrementSafeOrLog(size_t length)
+{
+    if (!buffPtrIncrementSafe(length)) {
+        LOG(ERROR) << "buffPtrIncrementSafe(" << std::dec << length << ") Failed!";
+        return false;
+    }
+    return true;
+}
+
+int BaseClass::finalize_begin(size_t &tailroom)
+{
+    tailroom = 0;
+    if (m_parse__) {
+        TLVF_LOG(DEBUG) << "finalize() called but m_parse__ is set";
+        return 0;
+    }
+    if (m_finalized__) {
+        TLVF_LOG(DEBUG) << "finalize() called for already finalized class";
+        return 0;
+    }
+    if (!isPostInitSucceeded()) {
+        TLVF_LOG(ERROR) << "post init check failed";
+        return -1;
+    }
+    if (m_inner__) {
+        if (!m_inner__->finalize()) {
+            TLVF_LOG(ERROR) << "m_inner__->finalize() failed";
+            return -1;
+        }
+        tailroom = m_inner__->getMessageBuffLength() - m_inner__->getMessageLength();
+        m_buff_ptr__ -= tailroom;
+    }
+    return 1;
+}
