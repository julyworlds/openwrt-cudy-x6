+    BUFF_INC_IF_RE = re.compile(r'^(\s*)if \((.*)!buffPtrIncrementSafe\((.*)\)\) \{$')
+    BUFF_INC_LOG_RE = re.compile(r'^\s*LOG\(ERROR\) << "buffPtrIncrementSafe\(" << std::dec << .* << "\) Failed!";$')
+
+    def compactBuffIncrementLogs(self, code_lines):
+        # "if (!buffPtrIncrementSafe(x)) { LOG(ERROR) << ...; return false; }"
+        # -> "if (!buffPtrIncrementSafeOrLog(x)) { return false; }"
+        out = []
+        i = 0
+        while i < len(code_lines):
+            line = code_lines[i]
+            m = self.BUFF_INC_IF_RE.match(line)
+            if m and i + 1 < len(code_lines) and self.BUFF_INC_LOG_RE.match(code_lines[i + 1]):
+                out.append("%sif (%s!buffPtrIncrementSafeOrLog(%s)) {" %
+                           (m.group(1), m.group(2), m.group(3)))
+                i += 2
+                continue
+            out.append(line)
+            i += 1
+        return out
+
     def writeFile(self, code_lines, file_suffix):
         if file_suffix == ".h":
             file_path = os.path.join(self.conf_output_path_include, self.yaml_path)
