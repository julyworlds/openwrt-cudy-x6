From: prplmesh OpenWrt package
Subject: [PATCH] controller: evaluate roaming candidates

When a client's uplink RSSI is below the roaming threshold of its radio
(patch 280), start the optimal path task for it: 11k or cross
measurements, then an 11v request if another access point is clearly
better. At most once a minute per client, and not for clients known not
to support 11v (they can't be moved without disconnecting them).

--- a/controller/src/beerocks/master/controller.h
+++ b/controller/src/beerocks/master/controller.h
@@ -745,6 +745,9 @@
 
     db &database;
     task_pool m_task_pool;
+
+    /** Earliest time each roaming candidate may be evaluated again. */
+    std::unordered_map<sMacAddr, std::chrono::steady_clock::time_point> m_roaming_next_check;
     periodic_operation_pool operations;
     beerocks::controller_ucc_listener m_controller_ucc_listener;
 
--- a/controller/src/beerocks/master/controller.cpp
+++ b/controller/src/beerocks/master/controller.cpp
@@ -2470,11 +2470,32 @@
         if (station && !station->is_bSta() && radio && rcpi > 0 && rcpi <= beerocks::RCPI_MAX) {
             auto threshold = radio->metric_reporting_policies.sta_reporting_rcpi_threshold;
             if (threshold && rcpi < threshold) {
-                LOG(INFO) << "Roaming candidate " << sta_link_metric->sta_mac() << " on "
-                          << bssid_info.bssid << ": RSSI "
