From: prplmesh OpenWrt package
Subject: [PATCH] agent: report all connected clients once autoconfiguration completes

The nl80211 connected clients sweep only reports new or changed
clients. Its periodic reconciliation can run before the agent finished
autoconfiguration, so the association notifications of clients that
were already connected are dropped ("Controller is not connected").
The sweep requested when autoconfiguration completes then skipped them
as unchanged, and the controller never got their capabilities, which
only travel in that notification. Make the explicitly requested sweep
report every client.

Also fill the 11v (BSS transition) capability of swept stations from
hostapd's ext_capab, and mark 11k as unknown (STA_CAPS_RRM_UNKNOWN):
hostapd's STA output has no RM Enabled Capabilities.

--- a/common/beerocks/bwl/include/bwl/ap_wlan_hal.h
+++ b/common/beerocks/bwl/include/bwl/ap_wlan_hal.h
@@ -478,6 +478,13 @@
     virtual bool supports_connected_clients_reconciliation() const { return false; }
 
     /**
+     * @brief Make the next connected clients sweep report every client,
+     * including the ones already reported, e.g. because the earlier events
+     * were dropped while the agent was not linked to the controller yet.
+     */
+    virtual void request_full_connected_clients_sweep() {}
+
+    /**
      * @brief Start WPS PBC procedure on a given VAP 
      *
      * @param iface_name VAP interface on which to start WPS PBC
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.h
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.h
@@ -98,6 +98,7 @@
      */
     virtual bool pre_generate_connected_clients_events() override;
     virtual bool supports_connected_clients_reconciliation() const override { return true; }
+    virtual void request_full_connected_clients_sweep() override { m_full_sweep = true; }
 
     virtual bool start_wps_pbc() override;
     virtual bool set_mbo_assoc_disallow(const std::string &bssid, bool enable) override;
@@ -152,6 +153,7 @@
     std::unordered_set<sMacAddr> m_handled_clients;
     std::unordered_map<sMacAddr, int> m_connected_clients;
     std::unordered_map<sMacAddr, int> m_clients_before_sweep;
+    bool m_full_sweep = false; // report unchanged clients too in the next sweep
     sMacAddr m_prev_client_mac = {};
     bool m_queried_first       = false;
     int m_vap_id_in_progress   = INVALID_VAP_ID;
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
@@ -1463,6 +1463,19 @@
     }
     sta_caps_from_rates(supported_rates, msg->params.capabilities);
 
+    // 802.11v: BSS Transition bit (19) of the Extended Capabilities element,
+    // which hostapd prints as hex in ext_capab.
+    const auto &ext_capab = options["ext_capab"];
+    if (ext_capab.length() >= 6) {
+        auto byte2 = std::strtoul(ext_capab.substr(4, 2).c_str(), nullptr, 16);
+        msg->params.capabilities.btm_supported = (byte2 & 0x08) ? 1 : 0;
+    }
+    // 802.11k: hostapd's STA output has no RM Enabled Capabilities, so it is
+    // unknown here; let the controller try beacon reports.
+    msg->params.capabilities.rrm_supported         = beerocks::message::STA_CAPS_RRM_UNKNOWN;
+    msg->params.capabilities.beacon_report_active  = 1;
+    msg->params.capabilities.beacon_report_passive = 1;
+
     return msg_buff;
 }
 
@@ -1565,7 +1578,8 @@
             }
 
             auto known = m_connected_clients.find(sta_mac);
-            if (known != m_connected_clients.end() && known->second == m_vap_id_in_progress) {
+            if (!m_full_sweep && known != m_connected_clients.end() &&
+                known->second == m_vap_id_in_progress) {
                 continue; // unchanged client: no duplicate event
             }
             m_connected_clients[sta_mac] = m_vap_id_in_progress;
@@ -1616,6 +1630,7 @@
     m_clients_before_sweep.clear();
     m_enumerated_vaps.clear();
     m_handled_clients.clear();
+    m_full_sweep            = false;
     is_finished_all_clients = true;
     return true;
 }
--- a/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
+++ b/agent/src/beerocks/fronthaul_manager/ap_manager/ap_manager.cpp
@@ -2255,6 +2255,10 @@
     }
     case beerocks_message::
         ACTION_APMANAGER_HOSTAP_GENERATE_CLIENT_ASSOCIATION_NOTIFICATIONS_REQUEST: {
+        // Explicit request (the agent finished autoconfiguration): report all
+        // clients again, the periodic sweep may already have imported them
+        // while their notifications couldn't reach the controller.
+        ap_wlan_hal->request_full_connected_clients_sweep();
         m_generate_connected_clients_events = true;
         if (!ap_wlan_hal->pre_generate_connected_clients_events()) {
             LOG(WARNING) << "Failed to prepare for generate of clients connected events";
