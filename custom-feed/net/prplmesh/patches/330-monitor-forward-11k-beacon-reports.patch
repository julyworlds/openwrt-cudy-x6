From: prplmesh OpenWrt package
Subject: [PATCH] monitor: make 11k beacon measurements work

The monitor's handling of beacon reports had been disabled ("the AP
Manager already handles it"), but the AP Manager only answers EasyMesh
Beacon Metrics Queries. The prplMesh 11k requests sent by the monitor
(association handling capability probe, optimal path measurements) never
got their response and always timed out, so 11k roaming never worked.
Forward the reports for those requests again.

hostapd refuses beacon requests in a mode the station doesn't advertise
("does not support active beacon report"); many stations only do
passive or table measurements. Retry an active request as passive (at
least 120 TU) and then table before failing.

Also log the reporting mode and report when a beacon report is ignored
as too short (e.g. a refused request, rep_mode 4).

--- a/agent/src/beerocks/fronthaul_manager/monitor/monitor.cpp
+++ b/agent/src/beerocks/fronthaul_manager/monitor/monitor.cpp
@@ -1929,11 +1929,12 @@
     } break;
 
     case Event::RRM_Beacon_Response: {
-        /* TODO: The AP Manager already handles all the related stuff for
-         * Beacon Metrics Response, remove this case.
+        /* The AP Manager only turns beacon reports into EasyMesh Beacon
+         * Metrics Responses for EasyMesh Beacon Metrics Queries. Reports for
+         * the requests sent by this monitor (prplMesh 11k flows: association
+         * handling, optimal path) must still be answered here, otherwise
+         * those requests always time out.
          */
-        break;
-
         auto hal_data = static_cast<bwl::SBeaconResponse11k *>(data);
         LOG(INFO) << "Received beacon measurement response on BSSID: "
                   << (sMacAddr &)hal_data->bssid
--- a/common/beerocks/bwl/nl80211/mon_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/mon_wlan_hal_nl80211.cpp
@@ -426,8 +426,34 @@
     // Send the command
     parsed_obj_map_t reply;
     if (!wpa_ctrl_send_msg(cmd, reply, vap_iface_name)) {
-        LOG(ERROR) << __func__ << " failed";
-        return false;
+        // hostapd refuses modes the station doesn't advertise ("does not
+        // support active beacon report"). Many stations only do passive or
+        // table measurements: retry with those before giving up.
+        auto payload = cmd.find(' ', cmd.find("req_mode="));
+        bool retried = false;
+        if (measurement_mode == 1 && payload != std::string::npos &&
+            cmd.length() >= payload + 1 + 14) {
+            payload += 1; // op_class(2) channel(2) rand_ival(4) duration(4) mode(2)
+            for (auto mode : {"00", "02"}) {
+                std::string retry_cmd = cmd;
+                retry_cmd.replace(payload + 12, 2, mode);
+                if (std::string(mode) == "00" && req.duration < 120) {
+                    // passive: listen for at least about one beacon interval
+                    retry_cmd.replace(payload + 8, 4,
+                                      beerocks::string_utils::int_to_hex_string(htobe16(120), 4));
+                }
+                LOG(DEBUG) << __func__ << " - retrying with mode " << mode << ": " << retry_cmd;
+                reply.clear();
+                if (wpa_ctrl_send_msg(retry_cmd, reply, vap_iface_name)) {
+                    retried = true;
+                    break;
+                }
+            }
+        }
+        if (!retried) {
+            LOG(ERROR) << __func__ << " failed";
+            return false;
+        }
     }
 
     dialog_token = 0; //tmp_int;
@@ -701,7 +727,9 @@
         // Parse the report
         auto report = parsed_obj["_arg2"];
         if (report.length() < 52) {
-            LOG(WARNING) << "Invalid 11k report length!";
+            LOG(WARNING) << "Invalid 11k report length " << report.length() << " from "
+                         << parsed_obj["_mac"] << " (rep_mode " << parsed_obj["_arg1"]
+                         << ", report '" << report << "')";
             break;
         }
 
