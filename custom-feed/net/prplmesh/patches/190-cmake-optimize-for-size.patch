From: OpenWrt prplmesh package
Subject: [PATCH] cmake: add an option to optimize for size

The Release flags hard-code "-g1 -O2", which is appended after the
toolchain flags and so overrides the -Os that OpenWrt uses on small
targets. Add PRPLMESH_OPTIMIZE_SIZE (default OFF, behaviour unchanged)
that builds with -Os, per-function/data sections plus --gc-sections,
without asynchronous unwind tables (the code is built with
-fno-exceptions) and with hidden inline visibility for C++.

---
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -124,7 +124,13 @@
 
 # Default Compiler flags
 set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -Wall -Wextra -Werror -pthread -Wno-comment -Wno-unused-parameter -Wno-missing-field-initializers -fno-exceptions")
-set(CMAKE_C_FLAGS_RELEASE "${CMAKE_C_FLAGS_RELEASE} -g1 -O2 -Wformat -Wformat-security -fPIC -fPIE -fno-exceptions")
+option(PRPLMESH_OPTIMIZE_SIZE "Optimize for size instead of speed (embedded targets)" OFF)
+if(PRPLMESH_OPTIMIZE_SIZE)
+  set(PRPLMESH_OPT_FLAGS "-Os -ffunction-sections -fdata-sections -fno-asynchronous-unwind-tables")
+else()
+  set(PRPLMESH_OPT_FLAGS "-g1 -O2")
+endif()
+set(CMAKE_C_FLAGS_RELEASE "${CMAKE_C_FLAGS_RELEASE} ${PRPLMESH_OPT_FLAGS} -Wformat -Wformat-security -fPIC -fPIE -fno-exceptions")
 
 # Compiler specific flags
 if(CMAKE_CXX_COMPILER_VERSION VERSION_GREATER 9.1)
@@ -137,6 +143,11 @@
 # Release flags
 set(CMAKE_CXX_FLAGS "${CMAKE_C_FLAGS} ${CMAKE_CXX_FLAGS}")
 set(CMAKE_CXX_FLAGS_RELEASE "${CMAKE_CXX_FLAGS_RELEASE} ${CMAKE_C_FLAGS_RELEASE}")
+if(PRPLMESH_OPTIMIZE_SIZE)
+  set(CMAKE_CXX_FLAGS_RELEASE "${CMAKE_CXX_FLAGS_RELEASE} -fvisibility-inlines-hidden")
+  set(CMAKE_EXE_LINKER_FLAGS "${CMAKE_EXE_LINKER_FLAGS} -Wl,--gc-sections -Wl,--as-needed")
+  set(CMAKE_SHARED_LINKER_FLAGS "${CMAKE_SHARED_LINKER_FLAGS} -Wl,--gc-sections -Wl,--as-needed")
+endif()
 
 # Linker Options
 # - Setting the "rpath-link" linker variable to help the linker resolve secondery dependecies
