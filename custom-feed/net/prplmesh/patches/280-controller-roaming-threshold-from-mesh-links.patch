+// A client becomes a roaming candidate once its uplink RSSI drops below the
+// RSSI at which its agent hears its nearest mesh neighbour plus this margin:
+// it is then about as far away as the other agent, which may serve it better.
+constexpr int MESH_ROAMING_MARGIN_DB          = 4;
+constexpr int MESH_ROAMING_THRESHOLD_MIN_DBM  = -80;
+constexpr int MESH_ROAMING_THRESHOLD_MAX_DBM  = -55;
+constexpr auto MESH_ROAMING_THRESHOLD_PERIOD  = std::chrono::seconds(15);
+// Resend the policy only when the threshold moved at least this much (RCPI
+// units, 0.5 dB each) so link RSSI jitter doesn't cause policy churn.
+constexpr int MESH_ROAMING_THRESHOLD_HYST_RCPI = 6;
+
+/**
+ * Strongest wireless mesh link of an agent, as RSSI (dBm) and band.
+ *
+ * The stations connected to a backhaul BSS are the backhaul stations of
+ * other agents, and the RSSI the parent measures for them is the RSSI of
+ * that mesh link. It counts for the parent and for the agent owning the
+ * backhaul station (found by its interfaces, or as a child of the parent).
+ * This doesn't rely on agent->backhaul, which is inferred as wired for
+ * extenders whose WDS link shows up as a bridged LAN neighbour.
+ */
+bool strongest_mesh_link(db &database, const Agent &agent, int &rssi, beerocks::eFreqType &band)
+{
+    bool found = false;
+
+    for (const auto &parent : database.get_all_connected_agents()) {
+        if (!parent) {
+            continue;
+        }
+        for (const auto &radio : parent->radios) {
+            for (const auto &bss : radio.second->bsses) {
+                if (!bss.second || !bss.second->backhaul) {
+                    continue;
+                }
+                for (const auto &sta_entry : bss.second->connected_stations) {
+                    const auto &sta = sta_entry.second;
+                    if (!sta || !sta->stats_info ||
+                        sta->stats_info->rx_rssi == beerocks::RSSI_INVALID) {
+                        continue;
+                    }
+
+                    bool involved = parent.get() == &agent;
+                    if (!involved) {
+                        involved = agent.interfaces.find(sta_entry.first) != agent.interfaces.end() ||
+                                   agent.backhaul.backhaul_interface == sta_entry.first ||
+                                   agent.backhaul.parent_agent.lock() == parent;
+                    }
+                    if (!involved) {
+                        continue;
+                    }
+
+                    int link_rssi = sta->stats_info->rx_rssi;
+                    if (!found || link_rssi > rssi) {
+                        rssi  = link_rssi;
+                        band  = radio.second->get_band();
+                        found = true;
+                    }
+                }
+            }
+        }
+    }
+    return found;
+}
+
+/** RCPI threshold for the Metric Reporting Policy of a radio, 0 if unknown. */
+uint8_t mesh_rcpi_threshold(db &database, const Agent &agent, const Agent::sRadio &radio)
+{
+    int link_rssi;
+    beerocks::eFreqType link_band;
+    if (!strongest_mesh_link(database, agent, link_rssi, link_band)) {
+        return 0;
+    }
+
+    int threshold     = link_rssi + MESH_ROAMING_MARGIN_DB;
+    bool radio_is_24g = radio.get_band() == beerocks::FREQ_24G;
+    bool link_is_24g  = link_band == beerocks::FREQ_24G;
+    // 2.4 GHz loses less signal over the same distance.
+    if (radio_is_24g && !link_is_24g) {
+        threshold += database.config.roaming_band_pathloss_delta_db;
+    } else if (!radio_is_24g && link_is_24g) {
+        threshold -= database.config.roaming_band_pathloss_delta_db;
+    }
+    threshold = std::max(MESH_ROAMING_THRESHOLD_MIN_DBM,
+                         std::min(MESH_ROAMING_THRESHOLD_MAX_DBM, threshold));
+
+    return static_cast<uint8_t>((threshold + 110) * 2);
+}
+
+} // namespace
+
+void agent_monitoring_task::update_mesh_rcpi_thresholds()
+{
+    for (const auto &agent : database.get_all_connected_agents()) {
+        if (!agent) {
+            continue;
+        }
+        for (const auto &radio : agent->radios) {
+            int wanted  = mesh_rcpi_threshold(database, *agent, *radio.second);
+            int current = radio.second->metric_reporting_policies.sta_reporting_rcpi_threshold;
+            if (!wanted || std::abs(wanted - current) < MESH_ROAMING_THRESHOLD_HYST_RCPI) {
+                continue;
+            }
+            LOG(INFO) << "Roaming threshold of agent " << agent->al_mac << " changes ("
+                      << "RCPI " << current << " -> " << wanted << "), sending policy";
+            if (!send_multi_ap_policy_config_request(agent->al_mac, cmdu_tx)) {
+                LOG(ERROR) << "Failed to send Metric Reporting Policy to " << agent->al_mac;
+            }
+            break; // the policy covers all radios of the agent
+        }
+    }
+}
+
 void agent_monitoring_task::work()
 {
